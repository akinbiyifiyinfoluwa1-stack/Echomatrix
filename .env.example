# Environment
APP_ENV=development
APP_NAME=Echo Matrix
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Security
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
POSTGRES_USER=echo
POSTGRES_PASSWORD=echo_password
POSTGRES_DB=echo_matrix
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://echo:echo_password@postgres:5432/echo_matrix

# Redis
REDIS_URL=redis://redis:6379/0

# External APIs
NEWS_API_KEY=
CRYPTOPANIC_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
WHALE_ALERT_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# MT5 Bridge
MT5_BRIDGE_URL=http://windows-mt5-bridge:9000
MT5_BRIDGE_TOKEN=
